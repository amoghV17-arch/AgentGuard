# ============================================
# AgentGuard Environment Configuration
# ============================================
# Copy this file to .env and fill in values
# cp .env.example .env

# --- Database ---
POSTGRES_USER=agentguard
POSTGRES_PASSWORD=agentguard_dev
POSTGRES_DB=agentguard
DATABASE_URL=postgresql+asyncpg://agentguard:agentguard_dev@postgres:5432/agentguard

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Decision Engine ---
DECISION_LATENCY_BUDGET_MS=150
CONTENT_DETECTOR_TIMEOUT_MS=20
MANDATE_CHECK_TIMEOUT_MS=5
TX_RISK_TIMEOUT_MS=5
SCHEMA_CHECK_TIMEOUT_MS=5

# --- Fusion Thresholds ---
BLOCK_THRESHOLD=0.75
REVIEW_THRESHOLD=0.45

# --- Fusion Weights ---
WEIGHT_CONTENT=0.4
WEIGHT_TX_RISK=0.4
WEIGHT_MANDATE_SOFT=0.2

# --- Bypass Mode (Demo Only) ---
# Set to "true" ONLY for live demo comparison mode
ALLOW_BYPASS_MODE=false

# --- Feedback Loop ---
FEEDBACK_RETRAIN_THRESHOLD=50
FEEDBACK_GA_GENERATIONS=10
FEEDBACK_GA_POPULATION=20

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- LLM (for red_team + simulation ONLY) ---
# GEMINI_API_KEY=your-key-here

# --- Model Paths ---
ONNX_MODEL_PATH=blue_team/models/tx_risk.onnx
